# 环境变量配置示例文件
# 复制此文件为 .env 并填入真实的 API 密钥

# ========== LLM 配置 ==========
# 选择使用的提供商 (alibaba_bailian, deepseek, baidu_qianfan, zhipu_ai, moonshot)
LLM_PROVIDER=alibaba_bailian  # 使用阿里云百炼平台（推荐，免费额度充足）

# ========== 阿里云百炼配置（推荐） ==========
# 注册地址：https://help.aliyun.com/zh/dashscope/
# 获取 API Key：https://dashscope.console.aliyun.com/apiKey
# 通义千问系列模型（均有免费额度）:
#   qwen-plus          - Qwen-Plus（推荐，能力强，免费额度充足）
#   qwen-turbo         - Qwen-Turbo（速度快）
#   qwen-max           - Qwen-Max（最强能力）
#   qwen-max-latest    - Qwen-Max 最新版
ALIBABA_BAILIAN_API_KEY=sk-your-alibaba-api-key-here
ALIBABA_BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/api/v1/services/aigc/text-generation/generation
ALIBABA_BAILIAN_MODEL=qwen-plus

# ========== DeepSeek 配置（可选备选） ==========
# 注册地址：https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# ========== 百度千帆配置（可选备选） ==========
# 注册地址：https://cloud.baidu.com/product/wenxinworkshop
BAIDU_API_KEY=your-baidu-api-key-here
BAIDU_SECRET_KEY=your-baidu-secret-key-here
BAIDU_BASE_URL=https://qianfan.baidubce.com/v2/chat/completions
BAIDU_MODEL=ernie-4.5-turbo-128k

# ========== 智谱 AI 配置（可选备选） ==========
# 注册地址：https://open.bigmodel.cn/
ZHIPU_API_KEY=your-zhipu-api-key-here
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4/chat/completions
ZHIPU_MODEL=glm-4-flash

# ========== Moonshot 配置（可选备选） ==========
# 注册地址：https://platform.moonshot.cn/
MOONSHOT_API_KEY=your-moonshot-api-key-here
MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
MOONSHOT_MODEL=moonshot-v1-8k

# ========== 数据库配置 ==========
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password-here
DB_NAME=emotional_coaching_system_db

# ========== 应用配置 ==========
DEBUG=False
API_HOST=0.0.0.0
API_PORT=8000
